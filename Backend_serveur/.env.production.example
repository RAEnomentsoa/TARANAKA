# TARANAKA – production environment (copy to .env and fill in).
# Never commit the real file: .env is in .gitignore.

# Django
SECRET_KEY=change-me-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.taranaka.example

# PostgreSQL
DB_NAME=taranaka
DB_USER=taranaka
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Spec §11: only a clinical config validated in writing can be published.
CONFIG_VALIDEE_OBLIGATOIRE=True

# Spec §2: web accounts (agent_csb, superviseur, admin) must use two-factor
# login. A web account without it only gets a token to set it up.
TOTP_OBLIGATOIRE=True

# Behind the reverse proxy (nginx…): use the forwarded public host in links.
USE_X_FORWARDED_HOST=True

# Origins of the web dashboard, comma-separated, if it is served from another
# domain than the API. Leave empty when both share one domain (recommended).
CORS_ALLOWED_ORIGINS=https://tableau.taranaka.example
